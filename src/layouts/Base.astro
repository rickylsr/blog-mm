---
import '../styles/global.css';
import { site, posts } from '../lib/content.mjs';
const {
  title = site.title,
  description = site.description,
  image,
  noindex = false,
  article = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url);
const nav = [
  ['/', '首页'],
  ['/posts/', '归档'],
  ['/tags/', '标签'],
  ['/about/', '关于'],
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f8f9f6" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <title>{title === site.title ? title : `${title} · Ricky Lee`}</title>
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={site.title}
      href="/feed.xml"
    />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={new URL(image, site.url)} />}
    <meta
      name="twitter:card"
      content={image ? 'summary_large_image' : 'summary'}
    />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">
      跳到正文
    </a>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Ricky Lee 的博客首页">
        <span class="brand-mark">r.</span>
        <span>
          Ricky Lee<span class="brand-note">生活与折腾的记录</span>
        </span>
      </a>
      <nav aria-label="主导航">
        {nav.map(([href, label]) => (
          <a
            href={href}
            aria-current={Astro.url.pathname === href ? 'page' : undefined}
          >
            {label}
          </a>
        ))}
        <a class="search-link" href="/search/" aria-label="搜索文章">
          <svg
            viewBox="0 0 24 24"
            width="19"
            height="19"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            aria-hidden="true"
          >
            <circle cx="10.5" cy="10.5" r="6.5" />
            <path d="m16 16 4.5 4.5" />
          </svg>
          <span>搜索</span>
        </a>
      </nav>
    </header>
    <div class="site-shell">
      <aside class="author-card" aria-label="作者介绍">
        <img
          class="avatar"
          src="/assets/images/Profile-2.png"
          width="86"
          height="86"
          alt="Ricky Lee 的头像"
        />
        <div>
          <p class="author-name">Ricky Lee</p>
          <p class="author-bio">
            法学民工，不合格 Geek.
            <br />
            快乐生活，快乐科技。
          </p>
        </div>
        <div class="author-location">
          <span class="status-dot"></span> Singapore · 随时出发
        </div>
        <div class="author-links">
          <a href="https://github.com/rickylsr" rel="me">
            GitHub ↗
          </a>
          <a href="/feed.xml">RSS ↗</a>
        </div>
        <div class="sidebar-note">
          <span class="eyebrow">A PERSONAL NOTEBOOK</span>
          <p>
            把路上的见闻、厨房里的尝试，
            <br />
            和折腾过的小事，慢慢记下来。
          </p>
          <span>{posts.length} 篇记录 · 始于 2019</span>
        </div>
      </aside>
      <main id="main" tabindex="-1">
        <slot />
      </main>
    </div>
    <footer class="site-footer">
      <span>© {new Date().getFullYear()} Ricky Lee</span>
      <span>
        保持好奇，慢慢记录。<span class="footer-dot"> · </span>
        <a href="/feed.xml">订阅更新 ↗</a>
      </span>
    </footer>
  </body>
</html>
