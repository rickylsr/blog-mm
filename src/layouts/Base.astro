---
import Icon from '../components/Icon.astro';
import '../styles/global.css';
import { site, posts } from '../lib/content.mjs';
import SearchDialog from '../components/SearchDialog.astro';
const {
  title = site.title,
  description = site.description,
  image,
  noindex = false,
  article = false,
} = Astro.props;
const journal =
  Astro.url.pathname === '/' ||
  /^\/page\d+\/$/.test(Astro.url.pathname) ||
  Astro.url.pathname === '/tags/';
const canonical = new URL(Astro.url.pathname, site.url);
const nav = [
  ['/', '首页'],
  ['/posts/', '归档'],
  ['/tags/', '标签'],
  ['/about/', '关于'],
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <title>{title === site.title ? title : `${title} · Ricky Lee`}</title>
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={site.title}
      href="/feed.xml"
    />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={new URL(image, site.url)} />}
    <meta
      name="twitter:card"
      content={image ? 'summary_large_image' : 'summary'}
    />
    <slot name="head" />
  </head>
  <body class:list={{ journal }}>
    <a class="skip-link" href="#main">
      跳到正文
    </a>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Ricky Lee 的博客首页">
        <span translate="no">Ricky Lee&#39;s Blog</span>
      </a>
      <nav aria-label="主导航">
        {nav.map(([href, label]) => (
          <a
            href={href}
            aria-current={Astro.url.pathname === href ? 'page' : undefined}
          >
            {label}
          </a>
        ))}
        <button
          type="button"
          class="search-link"
          aria-label="搜索文章"
          aria-haspopup="dialog"
          aria-controls="search-dialog"
          aria-keyshortcuts="Control+k Meta+k"
          data-search-open
        >
          <Icon name="search" size={19} />
          <span>搜索</span>
          <kbd class="search-shortcut" data-search-shortcut aria-hidden="true">
            <span data-search-modifier>Ctrl</span>
            <span data-search-command hidden>
              <Icon name="command" size={12} />
            </span>
            <span>K</span>
          </kbd>
        </button>
      </nav>
    </header>
    <div class="site-shell">
      <aside class="author-card" aria-label="作者介绍">
        <img
          class="avatar"
          src="/assets/images/Profile-2.png"
          width="112"
          height="112"
          alt="Ricky Lee 的头像"
        />
        <div>
          <p class="author-name">Ricky Lee</p>
          <p class="author-bio">
            法学民工，不合格 Geek.
            <span class="author-bio-extra">
              <br />
              快乐生活，快乐科技。
            </span>
          </p>
        </div>
        <div class="author-links">
          <a href="https://github.com/rickylsr" rel="me">
            GitHub <Icon name="arrow-up-right" />
          </a>
          <a href="/feed.xml">
            <Icon name="rss" /> RSS
          </a>
        </div>
        <p class="author-count">
          {posts.length} 篇文章 ·{' '}
          <a href="/posts/">
            浏览归档 <Icon name="arrow-right" />
          </a>
        </p>
      </aside>
      <main id="main" tabindex="-1">
        <slot />
      </main>
    </div>
    <SearchDialog />
    <footer class="site-footer">
      <span>© {new Date().getFullYear()} Ricky Lee</span>
      <span>
        快乐生活，快乐科技。<span class="footer-dot"> · </span>
        <a href="/feed.xml">
          订阅更新 <Icon name="arrow-up-right" />
        </a>
      </span>
    </footer>
  </body>
</html>
