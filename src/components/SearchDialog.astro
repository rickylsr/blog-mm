---
import Icon from './Icon.astro';
import SearchPanel from './SearchPanel.astro';
---

<dialog class="search-dialog" id="search-dialog" aria-labelledby="search-title">
  <header class="search-dialog-header">
    <h2 id="search-title">搜索文章</h2>
    <button
      type="button"
      class="search-close"
      data-search-close
      aria-label="关闭搜索"
    >
      <Icon name="close" size={20} />
      <kbd aria-hidden="true">Esc</kbd>
    </button>
  </header>
  <SearchPanel id="dialog-search" />
  <footer class="search-dialog-footer">
    <span class="search-key-hints">
      <span class="search-key-hint">
        <kbd>
          <span class="sr-only">方向上键</span>
          <Icon name="arrow-up" size={12} />
        </kbd>
        <kbd>
          <span class="sr-only">方向下键</span>
          <Icon name="arrow-down" size={12} />
        </kbd>
        <span>选择</span>
      </span>
      <span class="search-key-hint">
        <kbd>
          <span class="sr-only">Enter</span>
          <Icon name="enter" size={12} />
        </kbd>
        <span>打开</span>
      </span>
    </span>
    <a href="/posts/">
      浏览归档 <Icon name="arrow-right" />
    </a>
  </footer>
</dialog>
