---
import Icon from './Icon.astro';
import { formatDate, tagLink } from '../lib/content.mjs';
const { posts, initialCount = posts.length, filterable = false } = Astro.props;
---

<div class="post-list">
  {posts.map((post, index) => (
    <article
      class="post-card"
      hidden={index >= initialCount}
      data-tags={filterable ? JSON.stringify(post.tags) : undefined}
    >
      <div class="post-meta">
        <time datetime={post.date}>{formatDate(post.date)}</time>
        <span class="meta-dot">·</span>
        <span>{post.minutes} 分钟阅读</span>
      </div>
      <h2>
        <a href={post.path}>{post.title}</a>
      </h2>
      <p>{post.excerpt}</p>
      <div class="post-bottom">
        <div class="post-tags">
          {post.tags.map((tag) => (
            <a href={tagLink(tag)} data-post-tag={filterable ? tag : undefined}>
              # {tag}
            </a>
          ))}
        </div>
        <a
          class="read-link"
          href={post.path}
          aria-label={`阅读全文：${post.title}`}
        >
          阅读全文 <Icon name="arrow-up-right" />
        </a>
      </div>
    </article>
  ))}
</div>
