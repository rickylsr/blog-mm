---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { posts, tagId } from '../../lib/content.mjs';
const pageSize = 5;
const tags = [...new Set(posts.flatMap((post) => post.tags))].sort((a, b) =>
  a.localeCompare(b, 'zh'),
);
---

<Base title="话题">
  <header class="page-heading">
    <h1>从一个话题开始</h1>
    <p>选一个感兴趣的话题，看看相关的文章。</p>
  </header>
  <section class="topic-browser" data-topic-browser data-page-size={pageSize}>
    <div class="tag-cloud" role="group" aria-label="按话题筛选">
      <button type="button" data-tag="" aria-pressed="true" disabled>
        全部 <span>{posts.length}</span>
      </button>
      {tags.map((tag) => (
        <button
          type="button"
          data-tag={tag}
          data-slug={tagId(tag)}
          aria-pressed="false"
          disabled
        >
          {tag}{' '}
          <span>{posts.filter((post) => post.tags.includes(tag)).length}</span>
        </button>
      ))}
    </div>
    <p class="topic-status muted" role="status" data-topic-status>
      共 {posts.length} 篇文章，已显示 {Math.min(pageSize, posts.length)} 篇。
    </p>
    <PostList posts={posts} initialCount={pageSize} filterable />
    <div class="topic-pagination">
      <button class="button" type="button" data-load-more hidden>
        加载更多
      </button>
    </div>
    <noscript>
      <p class="muted">
        筛选和加载更多需要 JavaScript，你也可以
        <a href="/posts/">浏览文章归档</a>。
      </p>
    </noscript>
  </section>
</Base>
<script src="../../scripts/topics.ts"></script>
