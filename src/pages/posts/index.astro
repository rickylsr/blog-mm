---
import Icon from '../../components/Icon.astro';
import Base from '../../layouts/Base.astro';
import { posts, formatDate } from '../../lib/content.mjs';
const years = [...new Set(posts.map((post) => post.date.slice(0, 4)))];
---

<Base title="全部文章">
  <header class="page-heading">
    <span class="eyebrow">THE ARCHIVE</span>
    <h1>一路写下来</h1>
    <p>{posts.length} 篇记录，关于生活，也关于我。</p>
  </header>
  {years.map((year) => (
    <section class="archive-year">
      <h2>
        {year}
        <span>
          {posts.filter((post) => post.date.startsWith(year)).length} 篇
        </span>
      </h2>
      <ul>
        {posts
          .filter((post) => post.date.startsWith(year))
          .map((post) => (
            <li>
              <time datetime={post.date}>{formatDate(post.date).slice(5)}</time>
              <a href={post.path}>{post.title}</a>
              <Icon name="arrow-up-right" />
            </li>
          ))}
      </ul>
    </section>
  ))}
</Base>
