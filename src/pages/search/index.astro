---
import Base from '../../layouts/Base.astro';
import Button from '../../components/Button.astro';
---

<Base title="搜索" noindex>
  <header class="page-heading">
    <span class="eyebrow">FIND A LITTLE SOMETHING</span>
    <h1>找一篇记录</h1>
    <p>搜标题、标签，也可以搜文章里的某句话。</p>
  </header>
  <form class="search-form" role="search">
    <label class="sr-only" for="query">
      搜索文章
    </label>
    <input
      id="query"
      name="q"
      type="search"
      placeholder="比如：日本、食谱、OpenWrt…"
      autocomplete="off"
    />
    <Button type="submit">搜索</Button>
  </form>
  <p class="muted" id="search-status" role="status">
    输入关键词，搜索这个博客。
  </p>
  <ul class="search-results" id="search-results"></ul>
  <noscript>
    搜索需要 JavaScript。你也可以<a href="/posts/">浏览全部文章</a>。
  </noscript>
</Base>
<script>
  const input = document.querySelector<HTMLInputElement>('#query')!;
  const status = document.getElementById('search-status')!;
  const results = document.getElementById('search-results')!;
  let indexPromise:
    | Promise<
        Array<{
          title: string;
          path: string;
          text: string;
          tags: string[];
          date: string;
        }>
      >
    | undefined;
  let timer: ReturnType<typeof setTimeout>;
  let generation = 0;
  async function search() {
    const current = ++generation;
    const query = input.value.trim().toLocaleLowerCase();
    const url = new URL(location.href);
    if (input.value.trim()) url.searchParams.set('q', input.value.trim());
    else url.searchParams.delete('q');
    history.replaceState(null, '', url);
    results.replaceChildren();
    if (!query) {
      status.textContent = '输入关键词，搜索这个博客。';
      return;
    }
    status.textContent = '正在查找…';
    try {
      indexPromise ??= fetch('/search-index.json')
        .then((response) => {
          if (!response.ok) throw new Error('Search unavailable');
          return response.json();
        })
        .catch((error) => {
          indexPromise = undefined;
          throw error;
        });
      const index = await indexPromise;
      if (current !== generation) return;
      const terms = query.split(/\s+/);
      const matches = index.filter((post) =>
        terms.every((term) =>
          `${post.title} ${post.tags.join(' ')} ${post.text}`
            .toLocaleLowerCase()
            .includes(term),
        ),
      );
      status.textContent = matches.length
        ? `找到 ${matches.length} 篇记录`
        : '还没找到匹配的文章，换一个词试试。';
      for (const post of matches) {
        const item = document.createElement('li');
        const link = document.createElement('a');
        link.href = post.path;
        link.textContent = post.title;
        const date = document.createElement('time');
        date.dateTime = post.date;
        date.textContent = new Intl.DateTimeFormat('zh-CN', {
          year: 'numeric',
          month: 'long',
          day: 'numeric',
          timeZone: 'UTC',
        }).format(new Date(`${post.date}T00:00:00Z`));
        item.append(date, link);
        results.append(item);
      }
    } catch {
      if (current === generation)
        status.textContent = '搜索暂时不可用，请稍后重试，或从归档浏览文章。';
    }
  }
  input.addEventListener('input', () => {
    generation++;
    clearTimeout(timer);
    timer = setTimeout(search, 180);
  });
  document.querySelector('form')!.addEventListener('submit', (event) => {
    event.preventDefault();
    clearTimeout(timer);
    void search();
  });
  const initial = new URLSearchParams(location.search).get('q');
  if (initial) {
    input.value = initial;
    void search();
  }
</script>
