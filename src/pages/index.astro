---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { posts } from '../lib/content.mjs';
const pageSize = 5;
---

<Base>
  <header class="page-heading home-heading">
    <p class="eyebrow">生活 · 旅行 · 技术</p>
    <h1>最近的记录</h1>
    <p>记录琐碎杂事和一些折腾经验。快乐生活，快乐科技。</p>
  </header>
  <div class="section-heading">
    <h2>最新文章</h2>
    <a href="/posts/">全部 {posts.length} 篇 →</a>
  </div>
  <PostList posts={posts.slice(0, pageSize)} />
  {posts.length > pageSize && (
    <nav class="pagination" aria-label="文章分页">
      <span>第 1 / {Math.ceil(posts.length / pageSize)} 页</span>
      <a href="/page2/">更早的文章 →</a>
    </nav>
  )}
</Base>
