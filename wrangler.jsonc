{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ricky-blog",
  "compatibility_date": "2026-10-24",
  "assets": {
    "directory": "./_site",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },
  "workers_dev": true,
  "routes": [
    {
      "pattern": "rlee.cc/*",
      "zone_name": "rlee.cc",
    },
  ],
}
